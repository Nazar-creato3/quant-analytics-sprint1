# qa-e2e example. No real secrets.
# The compose override hardcodes the test database password "test"
# and does not read this file, so a developer shell cannot substitute
# a production password. Copy to .env.e2e only if you need local notes.
# .env.e2e is gitignored. Never put live keys here.

QA_E2E_DEMO=true
POSTGRES_USER=apex
POSTGRES_PASSWORD=test
POSTGRES_DB=apex_intel
API_PORT=8100
FRONTEND_PORT=3100
POSTGRES_PORT=5442
REDIS_PORT=6390
LIVE_TRADING_ENABLED=false
