# Stand edge. HTTP only, on the compose network. Host port is published by
# docker-compose.stand.yml (18080). TLS stays on the production Caddy.
# basic_auth credentials are written into Caddyfile.stand.runtime at deploy
# time. This template has no password and no hash.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	basic_auth {
		__USER__ __HASH__
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
