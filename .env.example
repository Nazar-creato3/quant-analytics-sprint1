# ==============================================================
# APEX INTEL — Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ==============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=apex-intel
APP_ENV=development         # development | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
API_PREFIX=/api/v1

# ── Auth / Whitelist ─────────────────────────────────────────
# Comma-separated list of allowed email addresses
WHITELIST_EMAILS=admin@example.com,analyst@example.com
# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=apex_intel
POSTGRES_USER=apex
POSTGRES_PASSWORD=changeme
# Application role (RLS-enforced runtime connection)
APP_DB_USER=appuser
APP_DB_PASSWORD=changeme
# Optional explicit overrides (compose builds these from APP_DB_* by default):
# DATABASE_URL=postgresql+asyncpg://appuser:changeme@postgres:5432/apex_intel
# DATABASE_URL_SYNC=postgresql://appuser:changeme@postgres:5432/apex_intel
# MIGRATION_DATABASE_URL_SYNC=postgresql://apex:changeme@postgres:5432/apex_intel

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Realtime Data Pipeline (Redis Streams → TimescaleDB) ─────
# TimescaleDB runs as the existing `postgres` service (timescale/timescaledb image).
# Enable pipeline services: docker compose -f docker-compose.yml -f docker-compose.data.yml --profile data-pipeline up -d
#
# Active connectors: binance-ws (public WS, no key), moex-iss (public ISS, no key),
# tinkoff-client (requires TINKOFF_TOKEN), news-aggregator, stream-consumer.
# Coinglass: DISABLED — paid API; service removed from docker-compose.data.yml.
REDIS_STREAMS_URL=redis://redis:6379/0
STREAM_CONSUMER_GROUP=apex-consumer
STREAM_BATCH_SIZE=500
STREAM_FLUSH_INTERVAL_MS=500
STREAM_BINANCE_TRADES=raw:binance:trades
STREAM_BINANCE_DEPTH=raw:binance:depth
STREAM_TINKOFF_CANDLES=raw:tinkoff:candles
STREAM_MOEX_QUOTES=raw:moex:quotes
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt
MOEX_TICKERS=SBER,GAZP,LKOH,GMKN
MOEX_POLL_INTERVAL_SEC=5
NEWS_POLL_INTERVAL_SEC=60
# Tinkoff Invest API token (data pipeline reads TINKOFF_TOKEN; grid_bot uses TINKOFF_API_TOKEN — same value)
TINKOFF_TOKEN=
TINKOFF_API_TOKEN=
TINKOFF_FIGI_LIST=BBG004730N88,BBG004730RP0
# Coinglass — disabled (do not enable)
# COINGLASS_API_KEY=

# ── Market Data ──────────────────────────────────────────────
MARKET_DATA_PROVIDER=alpaca   # preferred keyed venue; Stooq then Yahoo are last-resort
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper endpoint
POLYGON_API_KEY=your-polygon-api-key
# Finnhub — see Economic calendar section below (also used for quotes)
# FRED (St. Louis Fed) — US macro series: CPI, VIX, unemployment, DXY, Brent, HY spread
# Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# FRED Canada series (CPALTT01CAM657N, IRSTCB01CAM156N, etc.) — separate key if registered under another account
FRED_CANADA_API_KEY=
# Bank of Canada Valet (boc_overnight_rate) is public — no key required
# EIA (U.S. Energy Information Administration) — optional petroleum/natural gas series
# Bulk zips PET.zip / NG.zip under ./рыночные данные (auto-detected) or set EIA_BULK_PATH
EIA_API_KEY=
EIA_BULK_PATH=
# Stooq — free daily ASCII bulk (US + world). Nightly Celery at 02:40 UTC.
# Prefer dropping ZIPs from https://stooq.com/db/h/ into STOOQ_BULK_DIR/inbox/
# or set STOOQ_COOKIE / STOOQ_API_KEY for automated download (never commit secrets).
STOOQ_API_KEY=
STOOQ_COOKIE=
STOOQ_BULK_DIR=
STOOQ_BULK_PACKAGES=d_us_txt.zip,d_world_txt.zip
# FRED macro local cache (nightly 02:50 UTC). Not a Stooq equity substitute.
FRED_BULK_DIR=
# Board equity EOD cache (Tiingo+Yahoo), nightly 02:55 UTC — Stooq complement
EQUITY_EOD_DIR=
# Alpha Vantage — optional free-tier equity/time-series supplement
ALPHA_VANTAGE_API_KEY=
# Financial Modeling Prep — US fundamentals (profile, income statement, key metrics)
# Register at https://site.financialmodelingprep.com/developer/docs/
FMP_API_KEY=your-fmp-api-key
# Licensed alt vendors (your contract keys — never commit). Empty = no HTTP.
BENZINGA_API_KEY=
QUIVER_API_KEY=
BRAIN_API_KEY=
BRAIN_API_BASE_URL=
MORNINGSTAR_API_KEY=
MORNINGSTAR_API_BASE_URL=
# Official QuantConnect dump from your account (lean data download). Not a scrape.
QUANTCONNECT_DATA_DIR=
# Regulatory data sidecar (OpenBB in isolated container — AGPL; network use only).
# Flip ENABLE_OPENBB_SOURCE=false to disable SEC/FINRA without redeploying code.
ENABLE_OPENBB_SOURCE=true
OPENBB_SERVICE_URL=http://openbb-service:6900
OPENBB_SERVICE_TIMEOUT_SECONDS=8
# CoinGecko Demo: x-cg-demo-api-key + https://api.coingecko.com/api/v3 (never header+query together)
COINGECKO_API_KEY=
NEWSCATCHER_API_KEY=
FINIMPULSE_API_KEY=
FINIMPULSE_SANDBOX_KEY=
APIBRICKS_API_KEY=
# Marketstack — EOD quotes for Asia/Europe equities (free tier, data-only in terminal)
# Register at https://marketstack.com/
MARKETSTACK_API_KEY=
# MOEX ISS — optional auth (public ISS endpoints work without credentials)
MOEX_API_TOKEN=
MOEX_USERNAME=
MOEX_PASSWORD=
# World Bank bulk CSV/zip directory (optional offline ingest — live API needs no key)
# Auto-detected as ./рыночные данные when that folder exists; override here if needed
WORLD_BANK_BULK_PATH=
# Eurostat ESTAT_downloads_data_* zips (SDMX-CSV) and extracted CSV store
EUROSTAT_DATA_DIR=
EUROSTAT_STORE_DIR=

# ── News ─────────────────────────────────────────────────────
# NewsAPI.org — financial headlines (free tier has ~24h delay)
NEWS_API_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-key

# ── Economic calendar (RapidAPI Investing.com + Finnhub fallback) ──
# RapidAPI key: subscribe to "Investing.Com Ultimate API" at https://rapidapi.com/
RAPIDAPI_KEY=
INVESTING_RAPIDAPI_HOST=investing-com-ultimate-api.p.rapidapi.com
INVESTING_RAPIDAPI_ENABLED=true
INVESTING_EVENTS_LOOKAHEAD_DAYS=7
# Finnhub free tier — secondary economic calendar source
FINNHUB_API_KEY=your-finnhub-api-key

# ── LLM (AITUNNEL — one key, route models by task) ─────────
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# GigaChat (Sber): LLM_PROVIDER=gigachat. Key = "Authorization key" from developers.sber.ru.
# Install the Russian Trusted Root CA on the server and point GIGACHAT_CA_BUNDLE at it.
# LLM_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2-Max
# GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca.pem
LLM_MODEL_CLIENT_CHAT=kimi-k3
LLM_MODEL_BATCH=kimi-k3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=30
# Health cron: live LLM probes default OFF (prevents ~500₽/2d bleed from hourly chat/triage).
HEALTH_LIVE_CHAT_CHECK_ENABLED=false
HEALTH_LIVE_CHAT_INTERVAL_SECONDS=10800
HEALTH_LLM_TRIAGE_ENABLED=false
HEALTH_LLM_TRIAGE_INTERVAL_SECONDS=3600
AITUNNEL_BURN_SPIKE_ALERT_RUB_24H=150

# ── Secrets backend (HashiCorp Vault KV v2) ─────────────────
# env = read trading keys from process env (dev default)
# vault = hydrate BINANCE/TINKOFF/FINAM keys from Vault at startup
SECRETS_BACKEND=env
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/apex-intel/trading
VAULT_USERS_PATH_PREFIX=secret/data/apex-intel/users
TRADING_KEY_ROTATION_DAYS=90

# ── Grid Bot Live Trading (grid_bot runtime) ────────────────
GRID_LIVE_SIGNOFF_CONFIRMATION=I_AUTHORIZE_LIVE_TRADING
# Binance Spot API (testnet or live — see docs/.env.venues.template)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Finam Trade API (MOEX — grid_bot connectivity; no data-pipeline connector yet)
FINAM_API_KEY=
FINAM_ACCOUNT_ID=
FINAM_BASE_URL=https://trade-api.finam.ru
BINANCE_BASE_URL=https://api.binance.com
IBKR_API_KEY=
IBKR_API_SECRET=
IBKR_ACCOUNT_ID=
IBKR_BASE_URL=
GRID_BOT_TIMEOUT_SECONDS=10

PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
# Safety: must be set to exact string to unlock live trading
LIVE_TRADING_CONFIRMATION=

# ── Risk Defaults ────────────────────────────────────────────
DEFAULT_PORTFOLIO_SIZE=100000        # USD
MAX_RISK_PER_TRADE_PCT=2.0           # % of portfolio risked per trade (stop distance)
DAILY_MAX_LOSS_PCT=5.0               # % of portfolio
MAX_PORTFOLIO_EXPOSURE_PCT=80.0      # max total deployed; cash buffer = 100 - this (20%)
MAX_DRAWDOWN_PCT=15.0
NO_TRADE_CONFIDENCE_THRESHOLD=0.45   # below this → no trade

# ── Position sizing caps (bankruptcy protection) ─────────────
MAX_POSITION_PCT=10.0                # max single position as % of total capital
MAX_NOTIONAL_PER_POSITION_USD=0      # optional hard USD cap per position (0 = disabled)
COMMISSION_RATE_PCT=0.1              # per-side fee estimate for net-profit analytics

# ── Pipeline ─────────────────────────────────────────────────
PIPELINE_SCHEDULE_CRON="0 9 * * 1-5"  # weekdays 9am UTC
MANEUVER_COUNT=10
DEFAULT_WATCHLIST=AAPL,MSFT,GOOGL,AMZN,META,NVDA,SPY,QQQ,GLD,BTC-USD,7203.T,0700.HK,SAP.XETRA,BARC.L

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Notifications (optional) ─────────────────────────────────
EMAIL_PROVIDER=stub
EMAIL_PRIMARY_PROVIDER=stub
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Apex Intel
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000
UNISENDER_API_KEY=
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
WEBHOOK_URL=

# ── Twenty CRM (application origination sync) ─────────────────
# Syncs paywall applications (/apply) → Person + Company in your Twenty workspace.
# Create key: Twenty → Settings → API & Webhooks → Create key (copy once).
# Cloud base URL: https://api.twenty.com | Self-hosted: https://your-crm-domain
# If unset, sync is skipped (applications still work). See docs/TWENTY_CRM_INTEGRATION.md
TWENTY_API_URL=
TWENTY_API_KEY=
# Optional — only if your Twenty account has multiple workspaces (UUID from workspace settings)
TWENTY_WORKSPACE_ID=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Apex Intel

# ── Crypto stack / Integrations Hub (third_party + sidecars) ──
# Clone repos: .\scripts\setup-third-party.ps1  (or ./scripts/setup-third-party.sh on VPS)
# Sidecars:    .\scripts\start-all-crypto-sidecars.ps1
# VPS one-shot: ./scripts/setup-vps-crypto-integrations.sh
#
# third_party/ is gitignored — mount into backend in docker-compose.prod.yml.
# In Docker backend probes host sidecars via host.docker.internal (see prod overlay defaults).
APEX_THIRD_PARTY_ROOT=
CAP_BACKEND_URL=http://127.0.0.1:18000
OPENTAO_URL=http://127.0.0.1:3000
CELEBRUM_URL=http://127.0.0.1:8080
CRYPTO_PULSE_URL=http://127.0.0.1:5173
# Freqtrade REST API (default 8081 — avoids conflict with Celebrum :8080)
FREQTRADE_URL=http://127.0.0.1:8081
FREQTRADE_SIGNAL_PATH=
# Fincept Terminal — Windows desktop only; set path to FinceptTerminal.exe
FINCEPT_TERMINAL_EXE=
FINCEPT_APPDATA=
# TradingAgents full graph run (probe/import works without this)
TRADINGAGENTS_ALLOW_FULL_RUN=0
TRADINGAGENTS_PROBE_TIMEOUT=25
# GitHub API (optional — higher rate limits for /trading-engines health?github_check=1)
GITHUB_TOKEN=
MANEUVER_DEBATE_ENABLED=1
# OpenTao admin writes (optional)
OPENTAO_ADMIN_KEY=
# Crypto Pulse AI (optional — Gemini for research UI)
GEMINI_API_KEY=
