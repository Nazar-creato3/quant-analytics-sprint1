<!DOCTYPE html>
<html lang="en">
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #1a1a2e; line-height: 1.6; background: #ffffff; margin: 0; padding: 24px;">
  <div style="max-width: 560px; margin: 0 auto;">
    <img src="{{ logo_url }}" alt="Quant Analytics" width="72" height="72" style="display: block; margin: 0 auto 24px;" />
    <p>Your Quant Analytics password was changed successfully.</p>
    <ul style="font-size:14px;color:#475569;">
      <li><strong>Time:</strong> {{ changed_at }}</li>
      {% if ip %}<li><strong>IP:</strong> {{ ip }}</li>{% endif %}
      {% if user_agent %}<li><strong>Device:</strong> {{ user_agent }}</li>{% endif %}
    </ul>
    <p style="color:#dc2626;font-weight:600;">If you did not make this change, use the link below immediately.</p>
    {% if wasnt_me_url %}
    <p><a href="{{ wasnt_me_url }}" style="color:#dc2626;font-weight:600;">This wasn't me — revoke all sessions</a></p>
    {% else %}
    <p style="color:#dc2626;font-weight:600;">If you did not make this change, contact support immediately.</p>
    {% endif %}
    <p>— Quant Analytics Security</p>
  </div>
</body>
</html>
