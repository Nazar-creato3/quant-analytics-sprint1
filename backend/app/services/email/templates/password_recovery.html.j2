<!DOCTYPE html>
<html lang="en">
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #1a1a2e; line-height: 1.6; background: #ffffff; margin: 0; padding: 24px;">
  <div style="max-width: 560px; margin: 0 auto;">
    <img src="{{ logo_url }}" alt="Quant Analytics" width="72" height="72" style="display: block; margin: 0 auto 24px;" />
    <p>Hello{% if name %} {{ name }}{% endif %},</p>
    <p>We received a request to reset your password.</p>
    <p><a href="{{ reset_url }}" style="display:inline-block;padding:12px 24px;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px;">Reset password</a></p>
    <p style="font-size:13px;color:#64748b;">This link expires in {{ ttl_minutes }} minutes and can only be used once.</p>
    <p style="font-size:13px;color:#64748b;">If you did not request this, ignore this email.</p>
    <p>— Quant Analytics Security</p>
  </div>
</body>
</html>
