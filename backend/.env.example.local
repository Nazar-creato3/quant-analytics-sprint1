# Copy to backend/.env for local dev on host (Postgres via docker-compose.local.yml)
# Local development — do not commit (see root .gitignore)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
API_PREFIX=/api/v1

WHITELIST_EMAILS=admin@example.com,admin@example.com
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apex_intel
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_pass

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# Alpaca paper — quotes/bars only. Put real keys in gitignored backend/.env.alpaca.local
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# PLATFORM_ALPACA_API_KEY=
# PLATFORM_ALPACA_SECRET_KEY=

# ── Venue credentials (copy from docs/.env.venues.template; never commit secrets) ──
# Run: python backend/tools/wire_venue_keys.py after filling root .env
GRID_RUNTIME_PROFILE=staging
STAGING_IBKR_REQUIRED=false
BINANCE_BASE_URL=https://testnet.binance.vision
FINAM_BASE_URL=https://trade-api.finam.ru
TINKOFF_BASE_URL=invest-public-api.tbank.ru:443
TINKOFF_APP_NAME=QuantAnalytics
TINKOFF_SANDBOX=false

# ── P4-01 pilot limits ───────────────────────────────────────
GRID_PILOT_ENABLED=true
GRID_PILOT_MAX_NOTIONAL_PER_ORDER=100
GRID_PILOT_MAX_DAILY_LOSS=200
GRID_PILOT_MAX_ORDERS_PER_SESSION=3
GRID_PILOT_VENUE_ENABLED=true
GRID_PILOT_ALLOWED_VENUE=binance
GRID_PILOT_ALLOWED_SYMBOLS=BTCUSDT
